{
  "_说明": "job-hunter 配置模板：复制为 config.json 后按需修改。JSON 不支持注释，各块的 '_说明' 键仅为文档，脚本会忽略它。",
  "resume_path": "./resume.md",
  "greeting": "您好，我对贵司岗位非常感兴趣，期待进一步沟通！",
  "skills": ["Python", "FastAPI", "RAG", "Dify", "自动化测试"],
  "target_roles": ["AI应用工程师", "测试开发工程师"],
  "exclude_keywords": ["总监", "架构师", "首席", "VP", "P8", "P7", "保险"],
  "exclude_company_keywords": [],
  "boost_keywords": ["llm", "大模型", "agent", "rag", "gpt"],
  "must_contain": [],
  "body_exclude_keywords": ["夜班", "倒班", "驻场", "销售岗"],
  "min_score": 60,
  "default_count": 20,
  "report_dir": "data/reports",

  "salary_filter_说明": "薪资过滤：home_cities 内城市用 home_* 阈值，其余城市用 away_*；accept=低于即过滤，prefer 仅作文档参考。",
  "salary_filter": {
    "home_cities": ["深圳", "广州", "东莞", "佛山"],
    "home_min_accept": 8,
    "home_min_prefer": 10,
    "away_min_accept": 10,
    "away_min_prefer": 12
  },

  "job_pools_说明": "投递分组词表（ab_test_track 实验分组与实际投递共用此唯一事实源）。keywords 键名格式 'S级-xxx/A级-xxx/B级-xxx'，首段字母决定实验组别；历史 applications.category 按同名词典匹配。",
  "job_pools": {
    "keywords": {
      "S级-AI应用工程师": ["AI应用工程师", "RAG", "Agent开发"],
      "A级-车联网/智能汽车": ["车载测试", "智能座舱测试"],
      "B级-AI内容运营": ["内容运营", "AIGC运营"]
    },
    "target_distribution": {
      "AI应用/AI工程师": 0.4,
      "AI实施/工作流/RAG/Dify": 0.35,
      "RPA/Python自动化": 0.15,
      "技术支持/AI产品": 0.1
    },
    "notes": "target_distribution 各项加总应为 1.0，用于控制投递结构"
  },

  "city_pools_说明": "city_priority 值为 primary/secondary/tertiary，决定城市扫描优先级与顺序。",
  "city_pools": {
    "city_priority": {
      "深圳": "primary",
      "广州": "secondary",
      "佛山": "tertiary"
    }
  },

  "safety_说明": "风控护栏：恢复期降量、每日/每小时上限、夜间禁投、同公司去重天数。改小更容易触发保守策略。",
  "safety": {
    "recovery_days": 3,
    "recovery_daily_cap": 25,
    "normal_daily_cap": 50,
    "hourly_cap": 8,
    "night_ban_start": 22,
    "night_ban_end": 8,
    "dedup_days": 7
  },

  "keyword_tiers_说明": "搜索词分层：P0 主线每天扫，P1/P2/P3 轮换验证，避免词表膨胀拖慢单轮。",
  "keyword_tiers": {
    "P0_主线": ["AI应用工程师", "AI实施"],
    "P1_机会": ["测试开发"],
    "P2_验证": ["解决方案工程师"],
    "P3_行业向": ["智能汽车"]
  },

  "schedule_说明": "launchd 定时触发时间（本地 24h 制）+ 抖动分钟数，由 run_daily.sh / launchd 使用。",
  "schedule": {
    "times": ["09:00", "15:30"],
    "jitter_minutes": 10
  },
  "target_cities": ["深圳", "广州"],
  "search_keywords": ["AI应用工程师", "AI实施", "测试开发"]
}
